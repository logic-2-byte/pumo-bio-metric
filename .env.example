# =====================================================================
# Biometric capture service
# =====================================================================
DEBUG=false
APP_ENV=production

# This service's own database (used by alembic / the FastAPI app itself).
# NOT the LMS. See LMS_DB_* below.
DB_HOST=localhost
DB_PORT=5432
DB_NAME=biometric
DB_USER=postgres
DB_PASSWORD=
REDIS_PORT=6379

# ---------------------------------------------------------------------
# Readers are NOT configured here
#
# They are registered in the LMS console, under
# Attendance -> Biometric Readers, and stored in `biometric_devices`
# with their serial, address, port and branch. This service reads that
# table every LMS_SYNC_DEVICE_REFRESH_SECONDS, so a reader added there
# starts being polled a couple of minutes later with no restart and no
# change to this file.
#
# That is deliberate: a company runs one or two readers per branch, so
# the fleet is a property of the company, not of whichever host happens
# to be running this process. DEVICE_IP / DEVICE_SN / DEVICE_PORT used
# to live here as a single-device bootstrap and have been removed —
# a serial typed here that disagreed with the console produced punches
# filed against an unknown device, and nothing said so.
# ---------------------------------------------------------------------
