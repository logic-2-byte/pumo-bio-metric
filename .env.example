# =====================================================================
# Biometric capture service
# =====================================================================
DEBUG=false
APP_ENV=production

# This service's own database (used by alembic / the FastAPI app itself).
# NOT the LMS. See LMS_DB_* below.
DB_HOST=localhost
DB_PORT=5432
DB_NAME=biometric
DB_USER=postgres
DB_PASSWORD=
REDIS_PORT=6379

# =====================================================================
# The LMS database — where punches actually go
# =====================================================================
# The SAME PostgreSQL instance and database the LMS backend uses. The
# bridge writes straight into biometric_punch_log so capture keeps
# working while the backend is redeploying; the LMS reconciles those
# rows into staff_punches on its own schedule.
LMS_SYNC_ENABLED=true

# HOST depends on where this is running, and there are only two answers:
#
#   postgres    co-located with the LMS on the same Docker host. This is a
#               container name, so it resolves ONLY because
#               docker-compose.prod.yml joins the external `lms_internal`
#               network. The LMS stack publishes no database port, so
#               there is no host:port alternative — it is that network or
#               nothing.
#   <ip/name>   a branch box reaching a remote LMS. Then read the SSLMODE
#               note below, because it stops being optional.
LMS_DB_HOST=postgres
LMS_DB_PORT=5432
LMS_DB_NAME=l2b_lms

# Connect as biometric_bridge, NOT as postgres.
#
# Create it once with deploy/lms_bridge_role.sql, which grants exactly
# four statements' worth of access: read the device list, stamp
# heartbeats, insert raw punches. It cannot reach staff_punches or
# biometric_enrollments, so a leaked copy of this file cannot alter
# anybody's attendance. The superuser has no such ceiling — see the
# reasoning at the top of that file.
#
# The password must match what you substituted for CHANGE_ME there.
LMS_DB_USER=biometric_bridge
LMS_DB_PASSWORD=

# `disable` when the database is a container on this same Docker host:
# the LMS runs stock postgres:17-alpine, which has no TLS configured at
# all, so `require` is refused at connect time and the bridge never
# reaches the database. The hop is inside a private bridge network that
# never leaves the host, so there is nothing to encrypt.
#
# Set `require` the moment the database is somewhere else — this
# credential otherwise crosses a LAN that has a fingerprint reader on it,
# in the clear. That case needs TLS on the server first.
LMS_DB_SSLMODE=disable

# Timings.
#   HEARTBEAT    the finest resolution at which a reader's contact is written
#                to the LMS. Readers call in every few seconds; this throttles
#                that to one UPDATE a minute per device. Stay well inside the
#                LMS's 15-minute grace period.
#   SPOOL_FLUSH  how often to retry punches held on disk while the LMS
#                database is down. Not a capture path — capture is the readers
#                pushing, which keeps working throughout.
LMS_SYNC_HEARTBEAT_SECONDS=60
LMS_SYNC_SPOOL_FLUSH_SECONDS=60

# THE POLLING KNOBS ARE GONE and setting them now does nothing.
# LMS_SYNC_POLL_SECONDS, LMS_SYNC_FULL_SECONDS, LMS_SYNC_RETRY_SECONDS,
# LMS_SYNC_MAX_RETRY_SECONDS and LMS_SYNC_DEVICE_REFRESH_SECONDS all tuned an
# outbound loop that dialled each reader on TCP 4370 (pyzk, with an ICMP ping
# in front of every connect). That loop is deleted: a reader lives behind a
# branch router this service cannot route to, so every connect failed on a
# perfectly healthy device and cost egress to establish nothing.
#
# How often a reader calls in is now the reader's decision, taken from `Delay`
# in the handshake this service answers with (app/router/iclock.py).

# Punches held here when the LMS database cannot be reached. Must survive
# a restart — it is the only copy of a pushed punch until it lands, which
# is why docker-compose.prod.yml bind-mounts it and the deploy job chowns
# it to uid 10001 (the image runs unprivileged).
LMS_SYNC_SPOOL=spool/pending_punches.jsonl

# ---------------------------------------------------------------------
# Readers are NOT configured here
#
# They are registered in the LMS console, under
# Attendance -> Biometric Readers, and stored in `biometric_devices`.
# This service does not even read that table any more: a reader
# announces itself by the serial it sends when it calls in, and the
# console resolves that serial to a device, a branch and a set of PINs.
#
# WHAT YOU CONFIGURE IS ON THE DEVICE, not here. In the reader's own
# menu (Comm -> Ethernet / Cloud Server), set the server address to
# THIS service and enable ADMS / push mode. It connects by itself from
# then on; there is nothing to enter at this end and nothing to restart.
#
# That is deliberate: a company runs one or two readers per branch, so
# the fleet is a property of the company, not of whichever host happens
# to be running this process. DEVICE_IP / DEVICE_SN / DEVICE_PORT used
# to live here as a single-device bootstrap and have been removed —
# a serial typed here that disagreed with the console produced punches
# filed against an unknown device, and nothing said so.
# ---------------------------------------------------------------------
